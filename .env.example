# Inka Arthouse — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard. `.env.local` is git-ignored (or robocopy-skippable) so
# secrets never leave your machine.
#
# To activate Supabase mode after filling these in:
#   1. Set VITE_BACKEND=supabase
#   2. Restart `npm run dev`
#   3. You'll see a login screen instead of the app
#
# To go back to local-only Dexie mode at any time:
#   - Set VITE_BACKEND=dexie (or remove the line entirely)
#   - Restart `npm run dev`
# ---------------------------------------------------------------------------

# Which backend to use: "dexie" (browser IndexedDB) or "supabase" (cloud).
# Default is "dexie" — the local-only app you've been using.
VITE_BACKEND=dexie

# Supabase project URL — Project Settings → API → Project URL
# e.g. https://lkboboagiikvozvbcpvg.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — Project Settings → API → "anon" "public"
# This key is safe to ship to the browser; RLS policies enforce access.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Daily KPI digest (api/reports/daily-digest.ts) — SERVER-ONLY.
# Set these in Vercel (Preview and Production separately), never in a
# browser-visible VITE_* variable and never in a committed file.
# ---------------------------------------------------------------------------

# Shared secret for every digest request. Vercel cron sends it as
# `Authorization: Bearer <CRON_SECRET>`; manual reruns send the same header.
# Empty/unset = the endpoint answers 401 to everything (reports stop).
# Use a long random value without spaces. Never put it in a URL.
CRON_SECRET=

# Default destination for digest emails (one address). Required for email
# sends; downloads (dry=1) and diagnostics work without it.
REPORT_RECIPIENT=

# Optional comma-separated list of individual addresses that a manual
# `recipient=` override may use (exact, case-insensitive). Empty = no
# overrides allowed. No wildcards or domains.
REPORT_RECIPIENT_ALLOWLIST=

# Resend email API key and sender address used by the digest.
RESEND_API_KEY=
FROM_EMAIL=

# Server-side Supabase access for the digest. It uses VITE_SUPABASE_URL
# (falling back to SUPABASE_URL) with SUPABASE_SERVICE_ROLE_KEY (falling
# back to VITE_SUPABASE_ANON_KEY). Preview must point at STAGING only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

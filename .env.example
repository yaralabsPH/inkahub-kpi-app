# Inka Arthouse — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard. `.env.local` is git-ignored (or robocopy-skippable) so
# secrets never leave your machine.
#
# To activate Supabase mode after filling these in:
#   1. Set VITE_BACKEND=supabase
#   2. Restart `npm run dev`
#   3. You'll see a login screen instead of the app
#
# To go back to local-only Dexie mode at any time:
#   - Set VITE_BACKEND=dexie (or remove the line entirely)
#   - Restart `npm run dev`
# ---------------------------------------------------------------------------

# Which backend to use: "dexie" (browser IndexedDB) or "supabase" (cloud).
# Default is "dexie" — the local-only app you've been using.
VITE_BACKEND=dexie

# Supabase project URL — Project Settings → API → Project URL
# e.g. https://lkboboagiikvozvbcpvg.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — Project Settings → API → "anon" "public"
# This key is safe to ship to the browser; RLS policies enforce access.
VITE_SUPABASE_ANON_KEY=
